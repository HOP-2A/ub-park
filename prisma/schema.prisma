model Payment {
  id        String        @id @default(nanoid())
  bookingId String        @unique
  amount    Float
  method    PaymentMethod
  status    PaymentStatus
  paidAt    DateTime?

  booking Booking @relation(fields: [bookingId], references: [id])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  CARD
  CASH
  QPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}
