generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OWNER
  USER
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  DISABLED
}

model User {
  id        String   @id @default(nanoid())
  name      String
  clerkId   String   @unique
  email     String   @unique
  createdAt DateTime @default(now())
  role      UserRole @default(USER)

  bookings Booking[]
  places   Place[]   @relation("OwnerPlaces")
}

model Place {
  id        String @id @default(nanoid())
  name      String
  address   String
  city      String
  latitude  Float
  longitude Float

  ownerId String
  owner   User   @relation("OwnerPlaces", fields: [ownerId], references: [id])

  parkings ParkingSpot[]
}


// model ParkingSpot {
//   id           String  @id @default(nanoid())
//   number       String
//   pricePerHour Float
//   isAvailable  Boolean @default(true)

//   placeId String
//   place   Place  @relation(fields: [placeId], references: [id])

//   bookings Booking[]
// }
model ParkingSpot {
  id        String     @id @default(cuid())
  label     String
  x         Float
  y         Float
  width     Float
  height    Float
  placeId String
  place Place @relation(fields: [placeId], references: [id])
  rotation  Float      @default(0)
  status    SlotStatus @default(AVAILABLE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  bookings  Booking[]
}

model Booking {
  id            String @id @default(nanoid())
  userId        String
  slotId String

  startTime  DateTime
  endTime    DateTime?
  totalPrice Float
  status     BookingStatus @default(CONFIRMED)

  user        User        @relation(fields: [userId], references: [id])
  parkingSlot ParkingSpot @relation(fields: [slotId], references: [id])

  payment   Payment?
  createdAt DateTime @default(now())
  updatedAt   DateTime    @updatedAt
}
