generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OWNER
  USER
}

model User {
  id        String   @id @default(nanoid())
  name      String
  clerkId   String   @unique
  email     String   @unique
  createdAt DateTime @default(now())
  role      UserRole @default(USER)

  bookings Booking[]
  places   Place[]   @relation("OwnerPlaces")
}

model Place {
  id        String @id @default(nanoid())
  name      String
  address   String
  city      String
  latitude  Float
  longitude Float

  ownerId String
  owner   User   @relation("OwnerPlaces", fields: [ownerId], references: [id])

  parkings ParkingSpot[]
}

model ParkingSpot {
  id        String     @id @default(cuid())
  label     String
  x         Float
  y         Float
  width     Float
  height    Float
  placeId String
  place   Place  @relation(fields: [placeId], references: [id])
  rotation  Float      @default(0)
  status    SlotStatus @default(AVAILABLE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  bookings  Booking[]
}


model Booking {
  id          String      @id @default(cuid())
  userId      String 
  slotId      String
  slot        ParkingSpot @relation(fields: [slotId], references: [id])
  startTime   DateTime
  endTime     DateTime?
  totalAmount Float?
  payment     Payment?
  user        User        @relation(fields: [userId], references: [id])
  status      String      @default("ACTIVE") 
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Payment {
  id        String        @id @default(nanoid())
  bookingId String        @unique
  amount    Float
  method    PaymentMethod
  status    PaymentStatus
  paidAt    DateTime?

  booking Booking @relation(fields: [bookingId], references: [id])
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  DISABLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  CARD
  CASH
  QPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}
